      <featureName>
        <language>eng</language>
        <name>Qingnian Hub-G75 Lan‑Hai Expressway Qinjiang River Bridge</name>
      </featureName>
      <featureName>
        <displayName>true</displayName>
        <language>zho</language>
        <name>青年枢纽—G75兰海高速钦江大桥</name>
      </featureName>
      <sourceIndication>
        <categoryOfAuthority code="15">maritime</categoryOfAuthority>
        <countryName>China</countryName>
        <reportedDate>
          <s100:date>2026-08-25</s100:date>
        </reportedDate>
        <source>Announcement No.17第17号公告</source>
        <sourceType code="1">law or regulation</sourceType>
        <featureName>
          <language>eng</language>
          <name>CHINA MSA</name>
        </featureName>
        <featureName>
          <language>zho</language>
          <name>中华人民共和国海事局</name>
        </featureName>
      </sourceIndication>
      <textContent>
        <categoryOfText code="1">abstract or summary</categoryOfText>
        <information>
          <headline>Article 8</headline>
          <language>eng</language>
          <text>Except for emergencies such as taking refuge, vessels shall be prohibited from sounding sound signals in the waters between the Qingnian Hub-G75 Lan‑Hai Expressway Qinjiang River Bridge from 2200 to 0600 on the following day.</text>
        </information>
        <information>
          <headline>第八条</headline>
          <language>zho</language>
          <text>除避险等紧急情况外，青年枢纽至 G75 兰海高速钦江大桥水域每日 22 时至次日 6 时禁止船舶鸣放声号。</text>
        </information>
      </textContent>
      <restriction code="unknown" xsi:nil="true"/>
      <controlAuthority xlink:href="#i5" xlink:arcrole="http://www.iho.net/S-127/roles/controlAuthority" xlink:title="SrvControl"/>
      <geometry>
        <s100:surfaceProperty xlink:href="#s11"/>
      </geometry>
    </RestrictedAreaNavigational>
