        <name>青年枢纽下游水域</name>
      </featureName>
      <sourceIndication>
        <categoryOfAuthority code="15">maritime</categoryOfAuthority>
        <countryName>China</countryName>
        <reportedDate>
          <s100:date>2026-08-25</s100:date>
        </reportedDate>
        <source>Announcement No.17第17号公告</source>
        <sourceType code="1">law or regulation</sourceType>
        <featureName>
          <language>eng</language>
          <name>CHINA MSA</name>
        </featureName>
        <featureName>
          <language>zho</language>
          <name>中华人民共和国海事局</name>
        </featureName>
      </sourceIndication>
      <textContent>
        <categoryOfText code="2">extract</categoryOfText>
        <information>
          <headline>Article 15</headline>
          <language>eng</language>
          <text>The safe distance from the preceding vessel shall not be less than four times the length of the own vessel (not applicable to the waters of navigation structures).</text>
        </information>
        <information>
          <headline>第十五条</headline>
          <language>zho</language>
          <text>与前船安全距离不得少于4倍本船船长（不适用于通航建筑物水域）。</text>
        </information>
        <information>
          <headline>Article 19</headline>
          <language>eng</language>
          <text>Vessels navigating against the current shall give way to vessels navigating with the current.</text>
        </information>
        <information>
          <headline>第十九条</headline>
          <language>zho</language>
          <text>逆流船舶应当避让顺流船舶。</text>
        </information>
      </textContent>
