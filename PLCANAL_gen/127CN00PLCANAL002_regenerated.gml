  <members>
    <Applicability gml:id="i1">
      <featureName>
        <language>eng</language>
        <name>Vessels with a length of over 90 meters</name>
      </featureName>
      <featureName>
        <language>zho</language>
        <name>船长超过90米的船舶</name>
      </featureName>
      <vesselsMeasurements>
        <comparisonOperator code="1">greater than</comparisonOperator>
        <vesselsCharacteristics code="1">length overall</vesselsCharacteristics>
        <vesselsCharacteristicsValue>90</vesselsCharacteristicsValue>
        <vesselsCharacteristicsUnit code="1">metre</vesselsCharacteristicsUnit>
      </vesselsMeasurements>
      <theApplicableRxN xlink:href="#i4" xlink:arcrole="http://www.iho.net/S-127/roles/theApplicableRxN" xlink:title="InclusionType"/>
    </Applicability>
    <Applicability gml:id="i2">
      <featureName>
        <language>eng</language>
        <name>Ships In Foreign Nationality</name>
      </featureName>
      <featureName>
        <language>zho</language>
        <name>外国籍船舶</name>
      </featureName>
      <categoryOfVesselRegistry code="2">foreign</categoryOfVesselRegistry>
      <theApplicableRxN xlink:href="#i6" xlink:arcrole="http://www.iho.net/S-127/roles/theApplicableRxN" xlink:title="InclusionType"/>
    </Applicability>
    <Applicability gml:id="i3">
      <featureName>
        <language>eng</language>
        <name>Vessels with a length of over 40 meters</name>
      </featureName>
      <featureName>
        <language>zho</language>
        <name>船长超过40米的船舶</name>
      </featureName>
      <vesselsMeasurements>
        <comparisonOperator code="1">greater than</comparisonOperator>
        <vesselsCharacteristics code="1">length overall</vesselsCharacteristics>
        <vesselsCharacteristicsValue>40</vesselsCharacteristicsValue>
        <vesselsCharacteristicsUnit code="1">metre</vesselsCharacteristicsUnit>
      </vesselsMeasurements>
      <theApplicableRxN xlink:href="#i9" xlink:arcrole="http://www.iho.net/S-127/roles/theApplicableRxN" xlink:title="InclusionType"/>
    </Applicability>
    <Regulations gml:id="i4">
      <fixedDateRange>
        <dateEnd>
          <s100:date>2031-09-14</s100:date>
        </dateEnd>
        <dateStart>
          <s100:date>2026-09-15</s100:date>
        </dateStart>
      </fixedDateRange>
      <featureName>
        <language>eng</language>
        <name>Regulation on Navigation Precautionary Areas of the Pinglu Canal</name>
      </featureName>
      <featureName>
        <displayName>true</displayName>
        <language>zho</language>
        <name>平陆运河航行警戒区规定</name>
      </featureName>
      <sourceIndication>
        <categoryOfAuthority code="15">maritime</categoryOfAuthority>
        <countryName>China</countryName>
        <reportedDate>
          <s100:date>2026-08-25</s100:date>
        </reportedDate>
        <source>Announcement No.17第17号公告</source>
        <sourceType code="1">law or regulation</sourceType>
        <featureName>
          <language>eng</language>
          <name>CHINA MSA</name>
        </featureName>
        <featureName>
          <language>zho</language>
          <name>中华人民共和国海事局</name>
        </featureName>
      </sourceIndication>
      <categoryOfAuthority code="15">maritime</categoryOfAuthority>
      <textContent>
        <categoryOfText code="2">extract</categoryOfText>
        <information>
          <headline>Article 21</headline>
          <language>eng</language>
          <text>Before entering a navigation precautionary area, a vessel with a length of more than 90m shall proactively inform other vessels of its own maneuvering intentions, and both parties shall reach a mutual understanding on the avoidance measures;&#13;
&#13;
 no vessel shall meet another vessel within the navigation precautionary area.</text>
        </information>
        <information>
          <headline>第二十一条</headline>
          <language>zho</language>
          <text>船长超过90米的船舶在进入航行警戒区前，应当主动告知他船本船动态，双方统一避让意图，不得与他船在航行警戒区内会遇。</text>
        </information>
      </textContent>
      <isApplicableTo xlink:href="#i1" xlink:arcrole="http://www.iho.net/S-127/roles/isApplicableTo" xlink:title="InclusionType"/>
    </Regulations>
    <Authority gml:id="i5">
      <featureName>
        <language>eng</language>
        <name>GUANGXI MSA</name>
      </featureName>
      <featureName>
        <displayName>true</displayName>
        <language>zho</language>
        <name>广西海事局</name>
      </featureName>
      <categoryOfAuthority code="15">maritime</categoryOfAuthority>
    </Authority>
    <Regulations gml:id="i6">
      <fixedDateRange>
        <dateEnd>
          <s100:date>2031-09-14</s100:date>
        </dateEnd>
        <dateStart>
          <s100:date>2026-09-15</s100:date>
        </dateStart>
      </fixedDateRange>
      <featureName>
        <language>eng</language>
        <name>Pilotage Regulations for Inland Waters of the Pinglu Canal</name>
      </featureName>
      <featureName>
        <displayName>true</displayName>
        <language>zho</language>
        <name>平陆运河内河水域引航规定</name>
      </featureName>
      <sourceIndication>
        <categoryOfAuthority code="15">maritime</categoryOfAuthority>
        <countryName>China</countryName>
        <reportedDate>
          <s100:date>2026-08-25</s100:date>
        </reportedDate>
        <source>Announcement No.17第17号公告</source>
        <sourceType code="1">law or regulation</sourceType>
        <featureName>
          <language>eng</language>
          <name>CHINA MSA</name>
        </featureName>
        <featureName>
          <language>zho</language>
          <name>中华人民共和国海事局</name>
        </featureName>
      </sourceIndication>
      <textContent>
        <categoryOfText code="1">abstract or summary</categoryOfText>
        <information>
          <headline>Article 11</headline>
          <language>eng</language>
          <text>The following vessels navigating in inland waters shall apply for pilotage from the pilotage authority:&#13;
(1) Vessels of foreign nationality;&#13;
(2) Seagoing motor vessels of 1,000GT or more, except where the master has navigated a seagoing motor vessel of the same type within the preceding two months prior to the current voyage;&#13;
&#13;
&#13;
(3) Vessels whose length, breadth, draught, or height above the water surface approaches the limits of the navigable dimensions of the Pinglu Canal Fairway.</text>
        </information>
        <information>
          <headline>第十一条</headline>
          <language>zho</language>
          <text>下列船舶在内河水域航行，应当向引航机构申请引航：&#13;
（一） 外国籍船舶；&#13;
（二）1000总吨以上的海上机动船舶，但船长驾驶同一类型的海上机动船舶航行与上一航次间隔2个月以内的除外；&#13;
（三） 长、宽以及吃水或者水面以上高度接近平陆运河航道通航尺度限值的船舶。</text>
        </information>
      </textContent>
      <rxnCode>
        <categoryOfRxN code="1">navigation</categoryOfRxN>
        <actionOrActivity code="1">navigating with a pilot</actionOrActivity>
      </rxnCode>
      <isApplicableTo xlink:href="#i2" xlink:arcrole="http://www.iho.net/S-127/roles/isApplicableTo" xlink:title="InclusionType"/>
    </Regulations>
    <Applicability gml:id="i7">
      <featureName>
        <language>eng</language>
        <name>Vessels with a length of less than 90m</name>
      </featureName>
      <featureName>
        <language>zho</language>
        <name>船长小于90米的船舶</name>
      </featureName>
      <vesselsMeasurements>
        <comparisonOperator code="3">less than</comparisonOperator>
        <vesselsCharacteristics code="1">length overall</vesselsCharacteristics>
        <vesselsCharacteristicsValue>90</vesselsCharacteristicsValue>
        <vesselsCharacteristicsUnit code="1">metre</vesselsCharacteristicsUnit>
      </vesselsMeasurements>
    </Applicability>
    <Applicability gml:id="i8">
      <featureName>
        <language>eng</language>
        <name>Vessels Carrying Liquid Dangerous Goods in Bulk</name>
      </featureName>
      <featureName>
        <language>zho</language>
        <name>载运散装液体危险货物的船舶</name>
      </featureName>
      <categoryOfCargo code="4">liquid</categoryOfCargo>
      <categoryOfCargo code="1">bulk</categoryOfCargo>
      <categoryOfCargo code="7">dangerous or hazardous</categoryOfCargo>
      <categoryOfVessel code="4">bulk carrier</categoryOfVessel>
      <logicalConnectives code="1">logical conjunction</logicalConnectives>
    </Applicability>
    <Regulations gml:id="i9">
      <fixedDateRange>
        <dateEnd>
          <s100:date>2031-09-14</s100:date>
        </dateEnd>
        <dateStart>
          <s100:date>2026-09-15</s100:date>
        </dateStart>
      </fixedDateRange>
      <featureName>
        <language>eng</language>
        <name>Prohibited Acts for Navigation in the Pinglu Canal Fairway</name>
      </featureName>
      <featureName>
        <displayName>true</displayName>
        <language>zho</language>
        <name>平陆运河航道通航禁止行为</name>
      </featureName>
      <sourceIndication>
        <categoryOfAuthority code="15">maritime</categoryOfAuthority>
        <countryName>China</countryName>
        <reportedDate>
          <s100:date>2026-08-25</s100:date>
        </reportedDate>
        <source>Announcement No.17第17号公告</source>
        <sourceType code="1">law or regulation</sourceType>
        <featureName>
          <language>eng</language>
          <name>CHINA MSA</name>
        </featureName>
        <featureName>
          <language>zho</language>
          <name>中华人民共和国海事局</name>
        </featureName>
      </sourceIndication>
      <categoryOfAuthority code="15">maritime</categoryOfAuthority>
      <textContent>
        <categoryOfText code="2">extract</categoryOfText>
        <information>
          <headline>Article 9</headline>
          <language>eng</language>
          <text>(5) Within the fairway, vessels with a length exceeding 40 meters are prohibited from turning around in waters outside the designated turning areas.</text>
        </information>
        <information>
          <headline>第九条</headline>
          <language>zho</language>
          <text>（五）航道内禁止船长超过40米的船舶在公布的掉头区以外水域掉头。</text>
        </information>
      </textContent>
      <isApplicableTo xlink:href="#i3" xlink:arcrole="http://www.iho.net/S-127/roles/isApplicableTo" xlink:title="InclusionType"/>
    </Regulations>
    <RestrictedAreaNavigational gml:id="f1">
      <s100:featureObjectIdentifier>
        <s100:agency>CN</s100:agency>
