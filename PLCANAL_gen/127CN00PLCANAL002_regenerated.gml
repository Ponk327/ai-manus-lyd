          <s100:date>2026-08-25</s100:date>
        </reportedDate>
        <source>Announcement No.17第17号公告</source>
        <sourceType code="1">law or regulation</sourceType>
        <featureName>
          <language>eng</language>
          <name>CHINA MSA</name>
        </featureName>
        <featureName>
          <language>zho</language>
          <name>中华人民共和国海事局</name>
        </featureName>
      </sourceIndication>
      <textContent>
        <categoryOfText code="1">abstract or summary</categoryOfText>
        <information>
          <headline>Article 14</headline>
          <language>eng</language>
          <text>The navigation speed shall not exceed 15 kilometres per hour.</text>
        </information>
        <information>
          <headline>第十四条</headline>
          <language>zho</language>
          <text>航速不得超过每小时15公里。</text>
        </information>
      </textContent>
      <restriction code="27">speed restricted</restriction>
